<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:orientation="vertical"
            android:padding="20dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/titulo_app"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/subtitulo_app"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/secao_cadastro"
                android:textColor="@color/text_main"
                android:textSize="19sp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/editProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="Nome do Produto *"
                android:inputType="textCapSentences"
                android:maxLines="1" />
            <EditText
                android:id="@+id/editProductPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Preço (ex.: 149,90) *"
                android:inputType="numberDecimal|numberSigned"
                android:maxLines="1" />
            <EditText
                android:id="@+id/editProductDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Descrição (opcional)"
                android:inputType="textCapSentences"
                android:maxLines="2" />
            <EditText
                android:id="@+id/editProductQuantity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Quantidade em estoque *"
                android:inputType="number"
                android:maxLines="1" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btnInserirProduto"
                    style="@style/PrimaryAction"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Inserir Produto" />
                <Button
                    android:id="@+id/btnListarProdutos"
                    style="@style/SecondaryAction"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Listar Produtos" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/secao_busca"
                android:textColor="@color/text_main"
                android:textSize="19sp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/editSearchName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nome ou parte do nome"
                android:inputType="text"
                android:maxLines="1" />
            <Button
                android:id="@+id/btnBuscar"
                style="@style/SecondaryAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Buscar" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/secao_atualizacao"
                android:textColor="@color/text_main"
                android:textSize="19sp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/editUpdateId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="ID do produto"
                android:inputType="number"
                android:maxLines="1" />
            <EditText
                android:id="@+id/editUpdatePrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Novo preço"
                android:inputType="numberDecimal|numberSigned"
                android:maxLines="1" />
            <Button
                android:id="@+id/btnAtualizarPreco"
                style="@style/SecondaryAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Atualizar preço" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/secao_exclusao"
                android:textColor="@color/text_main"
                android:textSize="19sp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/editDeleteId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="ID para excluir apenas um produto"
                android:inputType="number"
                android:maxLines="1" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btnExcluirId"
                    style="@style/DangerAction"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Excluir pelo ID" />
                <Button
                    android:id="@+id/btnExcluirTodos"
                    style="@style/DangerAction"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Excluir Todos" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="28dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/secao_lista"
                android:textColor="@color/text_main"
                android:textSize="19sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/txtResumoEstoque"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="5dp"
                android:text="Carregando estoque..."
                android:textColor="@color/primary"
                android:textSize="15sp"
                android:textStyle="bold" />
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:background="@color/border" />
            <TextView
                android:id="@+id/txtListaProdutos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="4dp"
                android:paddingBottom="10dp"
                android:text="Ainda não há produtos na lista."
                android:textColor="@color/text_main"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
